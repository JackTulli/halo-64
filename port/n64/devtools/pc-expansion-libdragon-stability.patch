diff --git a/src/display.c b/src/display.c
index 61b375c..be2ba1d 100644
--- a/src/display.c
+++ b/src/display.c
@@ -351,6 +351,9 @@ static void apply_display_vi_config(resolution_t res, bitdepth_t bit, gamma_t ga
     vi_bug_workaround = (res.width == 320 && bit == DEPTH_16_BPP && filters == FILTERS_DISABLED);
 }
 
+/* Own exactly one VI reference while a display is open. */
+static bool display_vi_owned;
+
 void display_init( resolution_t res, bitdepth_t bit, uint32_t num_buffers, gamma_t gamma, filter_options_t filters )
 {
     assertf(__num_buffers == 0, "display_init() called while the display is already initialized.\nPlease close the current display with display_close() first.");
@@ -366,6 +369,7 @@ void display_init( resolution_t res, bitdepth_t bit, uint32_t num_buffers, gamma
         assertf(res.width % 2 == 0, "width must be divisible by 2 for 32-bit depth");
 
     vi_init();
+    display_vi_owned = true;
     vi_write_begin();
 
     /* Reset VI configuration to default, before proceeding to configure the
@@ -396,7 +400,7 @@ void display_init( resolution_t res, bitdepth_t bit, uint32_t num_buffers, gamma
 
     apply_display_vi_config(res, bit, gamma, filters);
 
-    surfaces = malloc(sizeof(surface_t) * __num_buffers);
+    surfaces = calloc(__num_buffers, sizeof(surface_t));
     assertf(surfaces, "Out of memory");
 
     /* Initialize buffers and set parameters */
@@ -520,8 +524,10 @@ void display_close()
 
     // Blank the image and wait until it actually happens, before
     // freeing the buffers.
-    vi_show(NULL);
-    vi_wait_vblank();
+    if (display_vi_owned) {
+        vi_show(NULL);
+        vi_wait_vblank();
+    }
 
     if (surfaces)
     {
@@ -541,6 +547,10 @@ void display_close()
     __alloc_height = 0;
     __alloc_bitdepth = 0;
     __alloc_buffers = 0;
+    if (display_vi_owned) {
+        vi_close();
+        display_vi_owned = false;
+    }
 }
 
 surface_t* display_try_get(void)
diff --git a/src/rdpq/rdpq.c b/src/rdpq/rdpq.c
index 4ec98fe..987df8c 100644
--- a/src/rdpq/rdpq.c
+++ b/src/rdpq/rdpq.c
@@ -705,6 +705,7 @@ void __rdpq_block_next_buffer(void)
     struct rdpq_block_state_s *st = &rdpq_block_state;
     assertf(__rdpq_inited, "a rdpq command was issued during block recording, but rdpq_init() hasn't been called yet");
 
+    bool grow_buffer = !st->pending_wptr;
     if (st->pending_wptr) {
         st->wptr = st->pending_wptr;
         st->wend = st->pending_wend;
@@ -761,7 +762,7 @@ void __rdpq_block_next_buffer(void)
     // Grow size for next buffer
     // We use doubling here to reduce overheads for large blocks
     // and at the same time start small.
-    if (st->bufsize < RDPQ_BLOCK_MAX_SIZE) st->bufsize *= 2;
+    if (grow_buffer && st->bufsize < RDPQ_BLOCK_MAX_SIZE) st->bufsize *= 2;
 }
 
